// Get a free hosted Postgres database in seconds: `npx create-db`

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id              Int      @id @default(autoincrement())
  nis             String   @unique
  nisn            String  @unique
  nik             String?  @unique
  fullName        String
  nickname        String?
  gender          String
  birthPlace      String?
  birthDate       DateTime?
  religion        String?
  address         String?
  phone           String?
  email           String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parents         Parent[]
  education       Education?
  developments    StudentDevelopment[]
  grades          Grade[]
  achievements    Achievement[]
  extracurriculars Extracurricular[]
  violations        Violation[]

}

model Parent {
  id              Int      @id @default(autoincrement())

  studentId       Int
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  relation        String
  name            String
  nik             String?
  birthPlace      String?
  birthDate       DateTime?
  education       String?
  occupation      String?
  income          String?
  phone           String?
  address         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

}

model Education {
  id          Int      @id @default(autoincrement())

  studentId   Int      @unique
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  schoolOrigin String?
  nisOrigin    String?
  yearEntry    Int?
  className    String?
  major        String?
  status       String   @default("ACTIVE")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudentDevelopment {
  id            Int      @id @default(autoincrement())

  studentId     Int
    student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYear  String
  semester      String
  height        Float?
  weight        Float?
  academic      String?
  attitude      String?
  social        String?
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId])
}

model Grade {
  id            Int      @id @default(autoincrement())

  studentId     Int
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  academicYear  String
  semester      String

  subject       String

  knowledge     Float?
  skill         Float?
  finalScore    Float?
  predicate     String?

  description   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId])
}

model Achievement {
  id             Int      @id @default(autoincrement())
  studentId      Int
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  achievementType String
  title           String
  level           String?
  rank            String?
  organizer       String?
  academicYear    String?
  date            DateTime?
  description     String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([studentId])
}

model Extracurricular {
  id           Int      @id @default(autoincrement())

  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  activityName String
  role         String?
  level        String?
  academicYear String?
  status       String   @default("ACTIVE")
  description  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([studentId])
}

model Violation {
  id           Int      @id @default(autoincrement())
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  violationType String
  level         String?
  points        Int?
  violationDate DateTime
  sanction      String?
  status        String   @default("ACTIVE")
  description   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId])
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}