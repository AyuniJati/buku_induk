// Get a free hosted Postgres database in seconds: `npx create-db`

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id              Int      @id @default(autoincrement())
  nis             String   @unique
  nisn            String  @unique
  nik             String?  @unique
  fullName        String
  nickname        String?
  gender          String
  birthPlace      String?
  birthDate       DateTime?
  religion        String?
  address         String?
  phone           String?
  email           String?
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parents         Parent[]
  education       Education?

}

model Parent {
  id              Int      @id @default(autoincrement())

  studentId       Int
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  relation        String
  name            String
  nik             String?
  birthPlace      String?
  birthDate       DateTime?
  education       String?
  occupation      String?
  income          String?
  phone           String?
  address         String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

}

model Education {
  id          Int      @id @default(autoincrement())

  studentId   Int      @unique
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  schoolOrigin String?
  nisOrigin    String?
  yearEntry    Int?
  className    String?
  major        String?
  status       String   @default("ACTIVE")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}